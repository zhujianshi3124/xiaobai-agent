{
  "name": "xiaobai-agent",
  "id": "dsh/toolkit",
  "displayName": "DSH 工具箱（registry/doctor/面板总装）",
  "version": "1.0.0",
  "contract": "^1.0",
  "requires": {
    "node": ">=22",
    "dshRuntime": ">=0.1.2-rc.1 <0.2.0 || >=0.2.0-rc.2 <0.3.0",
    "services": ["webServer"]
  },
  "provides": {
    "services": ["registry", "doctor"],
    "inject": ["webServer"]
  },
  "configSchema": {
    "type": "object",
    "meta": {},
    "dict": {
      "servicePrefix": { "type": "string", "meta": {} },
      "toolkitRoot": { "type": "string", "meta": {} },
      "doctorCli": { "type": "string", "meta": {} },
      "devicesFile": { "type": "string", "meta": {} },
      "backupRoot": { "type": "string", "meta": {} },
      "doctorConfigRoot": { "type": "string", "meta": {} },
      "registry": {
        "type": "object",
        "meta": {},
        "dict": {
          "statePath": { "type": "string", "meta": {} },
          "dataDir": { "type": "string", "meta": {} },
          "autoload": { "type": "boolean", "meta": {} },
          "auditLog": { "type": "boolean", "meta": {} },
          "auditFile": { "type": "string", "meta": {} },
          "retryLimit": { "type": "number", "meta": {} },
          "retryBackoffMs": { "type": "number", "meta": {} },
          "loadTimeoutMs": { "type": "number", "meta": {} },
          "saveDebounceMs": { "type": "number", "meta": {} }
        }
      },
      "doctor": {
        "type": "object",
        "meta": {},
        "dict": {
          "watchInterval": { "type": "number", "meta": {} },
          "failureThreshold": { "type": "number", "meta": {} },
          "historySize": { "type": "number", "meta": {} }
        }
      }
    }
  },
  "panels": [
    {
      "id": "toolkit-panel",
      "title": "xiaobai-agent 面板（插件开关与体检）",
      "slot": "settings.plugins.tab",
      "order": 90,
      "httpBase": "/api/{servicePrefix}-panel",
      "fallbackUi": "/api/{servicePrefix}-panel/ui",
      "realtime": ["sse", "poll"],
      "managedBy": "dsh/toolkit"
    }
  ],
  "aliases": {
    "@local/dsh-compact-router": "xiaobai-agent/compact-router",
    "@local/agent-memory": "xiaobai-agent/agent-memory",
    "dsh-rate-throttle": "xiaobai-agent/rate-throttle",
    "dsh-search-router": "xiaobai-agent/search-router"
  },
  "requirements": {
    "runtime": {
      "node": ">=22",
      "dsh": ">=0.1.2-rc.1 <0.2.0 || >=0.2.0-rc.2 <0.3.0"
    },
    "binaries": [],
    "packages": {},
    "registers": {
      "events": [],
      "services": [],
      "commands": [],
      "providers": []
    },
    "exports": {
      "$from": "package.json#exports"
    }
  },
  "requiredAliases": {
    "@local/dsh-compact-router": "xiaobai-agent/compact-router"
  }
}
