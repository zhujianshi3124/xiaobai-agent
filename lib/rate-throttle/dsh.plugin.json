{
  "name": "xiaobai-agent/rate-throttle",
  "id": "dsh/rate-throttle",
  "displayName": "速率限制与换源路由",
  "version": "1.0.0",
  "contract": "^1.0",
  "provides": {
    "entry": "./index.js",
    "inject": ["llm", "tokenMeter"]
  },
  "configSchema": {
    "type": "object",
    "meta": {},
    "dict": {
      "enabled": { "type": "boolean", "meta": {} },
      "throttleProviders": { "type": "array", "meta": {}, "inner": { "type": "string", "meta": {} } },
      "minIntervalMs": { "type": "number", "meta": {} },
      "maxRequestsPerMinute": { "type": "number", "meta": {} },
      "adaptive": { "type": "boolean", "meta": {} },
      "maxIntervalMs": { "type": "number", "meta": {} },
      "backoffFactor": { "type": "number", "meta": {} },
      "logProviders": { "type": "array", "meta": {}, "inner": { "type": "string", "meta": {} } },
      "logPath": { "type": "string", "meta": {} },
      "routing": {
        "type": "object",
        "meta": {},
        "dict": {
          "enabled": { "type": "boolean", "meta": {} },
          "autoGroups": { "type": "boolean", "meta": {} },
          "autoGroupTtlMs": { "type": "number", "meta": {} },
          "cooldownMs": { "type": "number", "meta": {} },
          "tpmTurnSkip": { "type": "boolean", "meta": {} },
          "tpmCooldownMs": { "type": "number", "meta": {} },
          "downgradeContextMargin": { "type": "number", "meta": {} },
          "maxDowngradeCompactsPerTurn": { "type": "number", "meta": {} },
          "metricsWindowMs": { "type": "number", "meta": {} },
          "metricsLogIntervalMs": { "type": "number", "meta": {} },
          "clearCooldownOnUserSwitch": { "type": "boolean", "meta": {} },
          "syncSelectionOnFailover": { "type": "boolean", "meta": {} }
        }
      }
    }
  },
  "requirements": {
    "runtime": {
      "node": ">=22",
      "dsh": ">=0.1.2-rc.1 <0.2.0"
    },
    "binaries": [],
    "packages": {},
    "registers": {
      "events": [
        "llm/adapters-updated",
        "agent/request",
        "agent/request-error",
        "session/event"
      ],
      "services": [],
      "commands": [],
      "providers": []
    },
    "exports": {}
  }
}
