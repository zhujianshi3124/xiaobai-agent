{
  "manifestVersion": 1,
  "name": "@local/dsh-toolkit/rate-throttle",
  "requirements": {
    "runtime": {
      "node": ">=22",
      "dsh": ">=0.1.2-rc.1 <0.2.0"
    },
    "binaries": [],
    "packages": {},
    "registers": {
      "inject": [
        "llm",
        "tokenMeter"
