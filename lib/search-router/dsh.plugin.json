{
  "name": "dsh-toolkit/search-router",
  "id": "dsh/search-router",
  "displayName": "搜索路由（按会话模型选后端）",
  "version": "1.0.0",
  "contract": "^1.0",
  "provides": {
    "entry": "./index.js",
    "providers": ["auto-search"],
    "inject": ["web"]
  },
  "configSchema": {
    "type": "object",
    "meta": {},
    "dict": {
      "mode": { "type": "union", "meta": {}, "list": [
        { "type": "const", "meta": {}, "value": "auto" },
        { "type": "const", "meta": {}, "value": "official" },
        { "type": "const", "meta": {}, "value": "local" }
      ] },
      "officialProviders": { "type": "array", "meta": {}, "inner": { "type": "string", "meta": {} } },
      "officialProviderPatterns": { "type": "array", "meta": {}, "inner": { "type": "string", "meta": {} } },
      "officialModelPatterns": { "type": "array", "meta": {}, "inner": { "type": "string", "meta": {} } },
      "defaultWhenUnknown": { "type": "union", "meta": {}, "list": [
        { "type": "const", "meta": {}, "value": "official" },
        { "type": "const", "meta": {}, "value": "local" }
      ] }
    }
  },
  "requirements": {
    "runtime": {
      "node": ">=22",
      "dsh": ">=0.1.2-rc.1 <0.2.0"
    },
    "binaries": [],
    "packages": {
      "@deepseek-ai/dsh-web": { "$from": "package.json#peerDependencies" }
    },
    "registers": {
      "events": [],
      "services": [],
      "commands": []
    },
    "exports": {}
  }
}
