{
  "manifestVersion": 1,
  "name": "dsh-toolkit/agent-memory",
  "id": "dsh/agent-memory",
  "displayName": "智能体内存台账",
  "version": "1.0.0",
  "contract": "^1.0",
  "configSchema": {
    "type": "object",
    "meta": {},
    "dict": {
      "dataRoot": { "type": "string", "meta": {} },
      "defaultWorkspace": { "type": "any", "meta": {} }
    }
  },
  "requirements": {
    "runtime": {
      "node": ">=22",
      "dsh": ">=0.1.2-rc.1 <0.2.0"
    },
    "binaries": [
      { "name": "npm" }
    ],
    "packages": {},
    "registers": {
      "inject": ["systemPrompt"],
      "events": [
        "session/created",
        "agent/inbox/claimed",
        "agent/pre-step",
        "session/event",
        "agent/request-error",
        "agent/request",
        "session/disposed"
      ],
      "services": [],
      "commands": [],
      "providers": []
    },
    "exports": {
      ".": "./lib/index.js",
      "./plugin": "./plugin.js"
    }
  }
}
