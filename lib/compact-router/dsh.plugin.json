{
  "name": "xiaobai-agent/compact-router",
  "id": "dsh/compact-router",
  "displayName": "压缩路由",
  "version": "1.3.0",
  "contract": "^1.0",
  "provides": {
    "entry": "./index.js",
    "services": ["compaction"],
    "inject": ["llm", "tokenMeter", "sessions", "commands"],
    "commands": [
      "compact-mode",
      "compact-llm",
      "compact-instant",
      "compact-auto",
      "compact-archive"
    ]
  },
  "configSchema": {
    "type": "object",
    "meta": {},
    "dict": {}
  },
  "requirements": {
    "runtime": {
      "node": ">=22",
      "dsh": ">=0.1.2-rc.1 <0.2.0 || >=0.2.0-rc.2 <0.3.0"
    },
    "binaries": [],
    "packages": {
      "@deepseek-ai/dsh-compaction-basic": {
        "$from": "package.json#peerDependencies"
      }
    },
    "registers": {
      "events": [],
      "providers": []
    },
    "exports": {}
  },
  "optionalDeps": [
    "xiaobai-agent/agent-memory"
  ]
}
