{
  "manifestVersion": 1,
  "name": "@local/dsh-toolkit/compact-router",
  "id": "dsh/compact-router",
  "displayName": "压缩路由",
  "version": "0.1.0",
  "contract": "^1.0",
  "configSchema": {
    "type": "object",
    "meta": {},
    "dict": {}
  },
  "requirements": {
    "runtime": {
      "node": ">=22",
      "dsh": ">=0.1.2-rc.1 <0.2.0"
    },
    "binaries": [],
    "packages": {
      "@deepseek-ai/dsh-compaction-basic": {
        "$from": "package.json#peerDependencies"
      }
    },
    "registers": {
      "inject": [
        "llm",
        "tokenMeter",
        "sessions",
        "commands"
      ],
      "events": [],
      "services": [
        "compaction"
      ],
      "commands": [
        "compact-mode",
        "compact-llm",
        "compact-instant",
        "compact-auto",
        "compact-archive"
      ],
      "providers": []
    },
    "exports": {
      ".": "./index.js"
    }
  },
  "optionalDeps": [
    "@local/dsh-toolkit/agent-memory"
  ]
}
