{
  "manifestVersion": 1,
  "name": "@local/dsh-toolkit/web-search-local",
  "id": "dsh/web-search-local",
  "displayName": "本地网页搜索与抓取",
  "version": "0.1.0",
  "contract": "^1.0",
  "provides": {
    "providers": ["local-multi", "local-fetch"]
  },
  "configSchema": {
    "type": "object",
    "meta": {},
    "dict": {
      "engines": { "type": "array", "meta": {}, "inner": { "type": "string", "meta": {} } }
    }
  },
  "requirements": {
    "runtime": {
      "node": ">=22",
      "dsh": ">=0.1.2-rc.1 <0.2.0"
    },
    "binaries": [],
    "packages": {
      "@deepseek-ai/dsh-web": { "$from": "package.json#peerDependencies" },
      "@deepseek-ai/schemastery": { "$from": "package.json#dependencies" }
    },
    "registers": {
      "inject": [
        "web"
      ],
      "events": [],
      "services": [],
      "commands": [],
      "providers": [
        "local-multi",
        "local-fetch"
      ]
    },
    "exports": {
      ".": "./index.js"
    }
  }
}
