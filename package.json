{
  "name": "dsh-toolkit",
  "version": "1.0.0",
  "scripts": {
    "build:contract": "tsc -p contract/tsconfig.json",
    "build:registry": "tsc -p registry/tsconfig.json",
    "build:doctor": "tsc -p doctor/tsconfig.json",
    "typecheck": "tsc -p contract/tsconfig.json --noEmit && tsc -p registry/tsconfig.json --noEmit && tsc -p doctor/tsconfig.json --noEmit",
    "test:contract": "node --test --test-force-exit test/contract.test.mjs",
    "test:registry": "node --test --test-force-exit test/registry.test.mjs",
    "test:doctor": "node --test --test-force-exit test/doctor.test.mjs",
    "test:panel": "node --test --test-force-exit test/panel-v2.test.mjs",
    "test": "npm run build:contract && npm run build:registry && npm run build:doctor && node scripts/pluggable-lint.mjs && node scripts/p4-no-subplugin-import-check.mjs && npm run typecheck && node --test --test-force-exit"
  },
  "type": "module",
  "description": "DSH 套件：rate-throttle / compact-router / agent-memory / search-router 四合一入口；一个版本号管全部。",
  "exports": {
    ".": "./index.js",
    "./contract": "./contract/dist/index.js",
    "./panel": "./panel/index.js",
    "./registry": "./registry/dist/index.js",
    "./doctor": "./doctor/dist/index.js",
    "./rate-throttle": "./lib/rate-throttle/index.js",
    "./compact-router": "./lib/compact-router/index.js",
    "./agent-memory": "./lib/agent-memory/lib/index.js",
    "./agent-memory/plugin": "./lib/agent-memory/plugin.js",
    "./search-router": "./lib/search-router/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "dsh.plugin.json",
    "lib/",
    "panel/",
    "!panel/docs",
    "contract/",
    "registry/",
    "doctor/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-compaction-basic": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-web": "^0.1.5-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-compaction-basic": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-web": "0.1.5-rc.2",
    "@types/node": "^22.0.0",
    "typescript": "5.9.3"
  }
}
